{
  "name": "@instrument-org/skills",
  "version": "0.0.0",
  "description": "Instrument Directory",
  "repository": {
    "type": "git",
    "url": "https://github.com/finalpointco/directory"
  },
  "author": {
    "name": "Finalpoint",
    "email": "oss@finalpoint.co"
  },
  "type": "module",
  "files": [],
  "scripts": {
    "check-and-test": "pnpm check:packages:install && turbo run check:actions check:packages:dedupe check:python check:types test check:syncpack check:unused check:gitignore check:spelling check:skill check:skills check:format --ui tui --continue=dependencies-successful --output-logs errors-only",
    "check-and-test:ci": "pnpm check:packages:install && turbo run check:actions check:python check:types test check:syncpack check:unused check:gitignore check:spelling check:skill check:skills --ui tui --continue=dependencies-successful --output-logs errors-only",
    "check:actions": "node scripts/check-actions.ts",
    "check:format": "oxfmt --check .",
    "check:gitignore": "node scripts/check-gitignore.ts",
    "check:unused": "knip",
    "check:packages:dedupe": "pnpm dedupe --check",
    "check:packages:install": "pnpm install --frozen-lockfile",
    "check:skills": "node scripts/check-skills-aggregate.ts",
    "check:skills-md": "node scripts/generate-skill-md.ts --check",
    "check:spelling": "node scripts/typos.ts",
    "check:syncpack": "syncpack lint",
    "check:types": "tsc --noEmit",
    "fix:format": "oxfmt .",
    "fix:spelling": "node scripts/typos.ts --write-changes",
    "fix:syncpack": "syncpack fix",
    "test": "turbo run test",
    "generate:skills-md": "node scripts/generate-skill-md.ts",
    "syncpack": "syncpack",
    "update:actions": "actions-up"
  },
  "devDependencies": {
    "@instrument-org/agent-hooks": "github:instrument-org/agent-hooks",
    "@types/node": "24.13.1",
    "actions-up": "^1.17.1",
    "jscodeshift": "^17.4.0",
    "knip": "^5.88.1",
    "oxfmt": "0.57.0",
    "syncpack": "14.2.0",
    "tokenx": "^1.6.0",
    "turbo": "^2.10.11",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "publishConfig": {
    "provenance": true
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "download",
      "version": "24.15.0"
    }
  }
}
