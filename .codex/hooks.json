{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "d=$(git rev-parse --show-toplevel 2>/dev/null) || { printf '{}'; exit 0; }; node \"$d/node_modules/@instrument-org/agent-hooks/format.mjs\"",
            "timeout": 30,
            "statusMessage": "Formatting edited files"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=$(git rev-parse --show-toplevel 2>/dev/null) || { printf '{}'; exit 0; }; node \"$d/node_modules/@instrument-org/agent-hooks/format.mjs\"",
            "timeout": 180,
            "statusMessage": "Formatting dirty files"
          }
        ]
      }
    ]
  }
}
